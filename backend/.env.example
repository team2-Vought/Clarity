# Скопіюйте у backend/.env та заповніть потрібні ключі.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Модель за замовчуванням (id з каталогу /api/models/)
LLM_DEFAULT_MODEL=openai:gpt-6-luna
LLM_TIMEOUT_SECONDS=120

# Віддалені провайдери: достатньо заповнити хоча б один ключ.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Локальні моделі через Ollama: спочатку виконайте ollama pull <model>.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODELS=

# Власний OpenAI-сумісний endpoint (необов'язково).
CUSTOM_LLM_LABEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

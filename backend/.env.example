# Скопіюйте у backend/.env та заповніть потрібні ключі.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production security (DEBUG=false). For local development these can stay unset.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true
# Лише за зворотним проксі (nginx): довіряти X-Forwarded-Proto/For. Без проксі —
# не вмикайте, інакше IP для лімітів входу й «https» підробляє будь-хто.
# DJANGO_BEHIND_PROXY=true
# DJANGO_NUM_PROXIES=1
# Адмінка — на нестандартній адресі; порожньо в продакшні — вимкнена.
# DJANGO_ADMIN_URL=staff-7f3a/
# Скільки днів діє вхід на пристрої (httpOnly-cookie)
# AUTH_TOKEN_DAYS=30
# У продакшні — лише ваш домен (без цього localhost у продакшні не дозволено)
# CORS_ALLOWED_ORIGINS=https://clarity.example.com

# База даних. Порожньо — SQLite (backend/db.sqlite3) для розробки.
# Продакшн: postgres://user:password@host:5432/clarity
DATABASE_URL=

# Де виконуються дискусії: thread — у процесі вебсервера (розробка);
# worker — окремим процесом `python manage.py discussion_worker` (продакшн:
# дискусії переживають перезапуск сервера і продовжуються самі).
# У продакшні — обов'язково worker: потоки thread обмежує лише DISCUSSION_THREAD_MAX.
DISCUSSION_RUNNER=thread
DISCUSSION_WORKER_CONCURRENCY=4
DISCUSSION_THREAD_MAX=4

# Адреса фронтенду — для посилань у листах (відновлення пароля)
FRONTEND_URL=http://localhost:5173
# Зібраний index.html для прев'ю публічних посилань (типово frontend/dist/index.html)
# FRONTEND_INDEX_HTML=

# Моніторинг помилок (Sentry чи GlitchTip). Порожньо — вимкнено.
SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# Пошта. Порожньо — листи друкуються в консоль бекенду.
# Напр. django.core.mail.backends.smtp.EmailBackend + EMAIL_HOST/EMAIL_PORT/...
DJANGO_EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Clarity <no-reply@localhost>

# Вхід через Google: Client ID типу «Web application» з Google Cloud Console
# (APIs & Services → Credentials). У «Authorized JavaScript origins» додайте адресу
# фронтенду, напр. http://localhost:5173. Порожньо — кнопки Google немає.
GOOGLE_CLIENT_ID=

# Модель за замовчуванням (id з каталогу /api/models/)
LLM_DEFAULT_MODEL=groq:qwen/qwen3.8-27b
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=0.6
LLM_RETRY_MAX_DELAY_SECONDS=6
# Скільки максимум чекати на 429 (ліміт токенів/хв провайдера)
LLM_RATE_LIMIT_MAX_DELAY_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1600
LLM_HISTORY_MAX_CHARS=24000
# Lease кроку дискусії (продовжується heartbeat-ом, поки крок триває)
LLM_ADVANCE_LEASE_SECONDS=90
# Моделі модератора й AI Devil (порожньо — автоматичний вибір нейтральної моделі)
LLM_MODERATOR_MODEL=
LLM_DEVIL_MODEL=

# Денні ліміти на одного користувача (0 — без ліміту).
DISCUSSION_DAILY_LIMIT=20
DISCUSSION_DAILY_ADVANCE_LIMIT=200
# Скільки уточнень можна поставити після фінального висновку
DISCUSSION_MAX_FOLLOWUPS=3
# Повтори кроку фоновим раннером при тимчасових збоях моделі
DISCUSSION_RUNNER_MAX_RETRIES=2

# Пошук в інтернеті для моделей. SEARCH_PROVIDER: auto | tavily | brave | searxng | wikipedia | off
# auto — перший налаштований провайдер, інакше Wikipedia (без ключа, лише енциклопедичні факти).
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
SEARXNG_URL=
SEARCH_MAX_RESULTS=4
SEARCH_MAX_QUERIES=10

# Віддалені провайдери: достатньо заповнити хоча б один ключ.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Локальні моделі через Ollama: спочатку виконайте ollama pull <model>.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODELS=

# Власний OpenAI-сумісний endpoint (необов'язково).
CUSTOM_LLM_LABEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=

# Користувачі можуть вставити власні ключі в «Налаштуваннях» — вони шифруються.
# Порожньо — секрет шифрування похідний від DJANGO_SECRET_KEY.
API_KEYS_SECRET=
# Перевіряти ключ запитом до провайдера перед збереженням
API_KEYS_VERIFY=true

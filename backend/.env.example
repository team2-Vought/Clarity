# Скопіюйте у backend/.env та заповніть потрібні ключі.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production security (DEBUG=false). For local development these can stay unset.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# DJANGO_SECURE_HSTS_PRELOAD=true

# Модель за замовчуванням (id з каталогу /api/models/)
LLM_DEFAULT_MODEL=openai:gpt-6-luna
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_RETRY_DELAY_SECONDS=0.6
LLM_RETRY_MAX_DELAY_SECONDS=6
# Скільки максимум чекати на 429 (ліміт токенів/хв провайдера)
LLM_RATE_LIMIT_MAX_DELAY_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=1600
LLM_HISTORY_MAX_CHARS=24000
LLM_ADVANCE_LEASE_SECONDS=210

# Денні ліміти на одного користувача (0 — без ліміту).
DISCUSSION_DAILY_LIMIT=20
DISCUSSION_DAILY_ADVANCE_LIMIT=500

# Віддалені провайдери: достатньо заповнити хоча б один ключ.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Локальні моделі через Ollama: спочатку виконайте ollama pull <model>.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODELS=

# Власний OpenAI-сумісний endpoint (необов'язково).
CUSTOM_LLM_LABEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_API_KEY=
